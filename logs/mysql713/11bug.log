https://bugs.mysql.com/bug.php?id=120909&thanks=4 Verified as described.

DROP DATABASE IF EXISTS repro713_11_final;
CREATE DATABASE repro713_11_final;
USE repro713_11_final;

SET SESSION sql_mode='ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION';
SET SESSION big_tables=0;
SET SESSION internal_tmp_mem_storage_engine='MEMORY';

CREATE TABLE src (
  id BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  c0 TEXT NULL
) ENGINE=InnoDB;

INSERT INTO src(c0) VALUES
  (NULL), (''), ('a'), ('b'), ('c');

CREATE TABLE l (
  id BIGINT NOT NULL PRIMARY KEY
) ENGINE=InnoDB;

CREATE TABLE r (
  id BIGINT NOT NULL PRIMARY KEY,
  c0 TEXT NULL
) ENGINE=InnoDB;

INSERT INTO l SELECT id FROM src;
INSERT INTO r SELECT id, c0 FROM src;

SELECT 'single' AS q,
       COUNT(EXISTS(SELECT 1 WHERE FALSE)) AS ref0,
       src.id AS ref1,
       COALESCE((NULL) XOR (src.id), CAST('x' AS SIGNED)) AS ref2
FROM src
GROUP BY
       src.id,
       COALESCE((NULL) XOR (src.id), CAST('x' AS SIGNED))
WITH ROLLUP
ORDER BY src.id
LIMIT 2;

SELECT 'split' AS q,
       COUNT(EXISTS(SELECT 1 WHERE FALSE)) AS ref0,
       s.id AS ref1,
       COALESCE((NULL) XOR (s.id), CAST('x' AS SIGNED)) AS ref2
FROM (
  SELECT l.id AS id, r.c0 AS c0
  FROM l
  JOIN (
    SELECT id, COUNT(*) AS c
    FROM r
    GROUP BY id
  ) rg ON l.id = rg.id
  JOIN r ON r.id = rg.id
) s
GROUP BY
       s.id,
       COALESCE((NULL) XOR (s.id), CAST('x' AS SIGNED))
WITH ROLLUP
ORDER BY s.id
LIMIT 2;

single:
q       ref0  ref1  ref2
single  5     NULL  NULL
single  1     1     NULL

split:
q       ref0  ref1  ref2
split   5     NULL  NULL
split   1     1     0

single:
-> Limit: 2 row(s)
    -> Sort: id
        -> Stream results
            -> Group aggregate with rollup: count(exists(select #2))
                -> Sort: ref1, ref2
                    -> Covering index scan on src using PRIMARY
-> Select #2
    -> Zero rows (Impossible WHERE)

split:
-> Limit: 2 row(s)
    -> Sort: id
        -> Stream results
            -> Group aggregate with rollup: count(exists(select #2))
                -> Nested loop inner join
                    -> Nested loop inner join
                        -> Sort: ref1, ref2
                            -> Covering index scan on l using PRIMARY
                        -> Single-row covering index lookup on r using PRIMARY
                    -> Index lookup on rg using <auto_key0>
                        -> Materialize
                            -> Group aggregate: count(0)
                                -> Covering index scan on r using PRIMARY
-> Select #2
    -> Zero rows (Impossible WHERE)

. 表达式语义分析
sql
COALESCE((NULL) XOR (src.id), CAST('x' AS SIGNED))
(NULL) XOR (src.id)：任何值与 NULL 进行逻辑异或，结果恒为 NULL（与 src.id 的具体值无关）。

CAST('x' AS SIGNED)：在给定的 sql_mode（含 STRICT_TRANS_TABLES）下，该转换仍然返回 0 并产生一个截断警告，不会因严格模式而变成 NULL。

因此，COALESCE 的第一个参数始终为 NULL，第二个参数恒为 0，最终整个表达式是一个与行数据无关的常量 0。

2. 单表为何返回 NULL
在 single 查询中：

表 src 直接扫描，优化器在解析阶段能够轻易识别出 (NULL) XOR (src.id) 是常数 NULL，进而将整个 COALESCE 表达式折叠为常量 0。

GROUP BY src.id, 常量0 WITH ROLLUP：正常情况下，基础分组行应当保留 ref2 = 0，仅在超级汇总行中将该键置为 NULL。

实际执行时，MySQL 的 ROLLUP 代码路径会将所有被标记为“常量”的分组键都错误地置为 NULL，不仅在汇总行中，就连基础分组行也被替换成了 NULL。

因此我们看到 ref2 在 id=1 的普通行中也显示为 NULL。

执行计划中 Sort: ref1, ref2 → Group aggregate with rollup 的顺序表明，ref2 在排序前已被错误计算为 NULL，所以最终输出了 NULL。

3. 多表为何返回 0
在 split 查询中：

数据源经过 JOIN、物化子查询 (rg) 和派生表 s 的包装，(NULL) XOR (s.id) 虽然逻辑上仍是常数 NULL，但优化器因跨多层查询块、涉及物化临时表，未能将整个表达式完全折叠为常量。

因此 COALESCE(...) 被视为依赖 s.id 的普通表达式（即使实际不依赖），保留运行时的计算。

此时 ROLLUP 能够正确区分基础分组行和汇总行：基础行保留计算结果 0，汇总行将分组键置为 NULL。

于是 split 结果中 id=1 的 ref2 正确显示为 0。