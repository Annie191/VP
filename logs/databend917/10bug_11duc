SELECT x.c0varchar, LENGTH(x.c0varchar) AS len
FROM (
    SELECT l.vp_rowid, l.c0varchar
    FROM l
    WHERE EXISTS (
        SELECT 1
        FROM r
        WHERE r.vp_rowid = l.vp_rowid
    )
) x
WHERE '-1297934617' LIKE x.c0varchar
ORDER BY x.vp_rowid;

