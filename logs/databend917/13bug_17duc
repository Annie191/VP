SET enable_query_result_cache = 0;

CREATE TABLE source (
    vp_rowid BIGINT NOT NULL,
    c0varchar VARCHAR NULL
) ENGINE=FUSE;

CREATE TABLE l (
    vp_rowid BIGINT NOT NULL
) ENGINE=FUSE;

CREATE TABLE r (
    vp_rowid BIGINT NOT NULL,
    c0varchar VARCHAR NULL
) ENGINE=MEMORY;

INSERT INTO source VALUES (1, ''), (2, 'a');
INSERT INTO l SELECT vp_rowid FROM source;
INSERT INTO r SELECT * FROM source;

CREATE VIEW v AS
SELECT l.vp_rowid, r.c0varchar
FROM l JOIN r ON l.vp_rowid = r.vp_rowid;

