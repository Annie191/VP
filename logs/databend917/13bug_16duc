DROP DATABASE IF EXISTS repro_databend917_db16_min;
CREATE DATABASE repro_databend917_db16_min;
USE repro_databend917_db16_min;

SET enable_query_result_cache = 0;

CREATE TABLE source (
    vp_rowid BIGINT NOT NULL,
    c1timestamp TIMESTAMP NULL
) ENGINE=FUSE;

CREATE TABLE l (
    vp_rowid BIGINT NOT NULL,
    c1timestamp TIMESTAMP NULL
) ENGINE=MEMORY;

CREATE TABLE r (
    vp_rowid BIGINT NOT NULL
) ENGINE=FUSE;

INSERT INTO source VALUES
    (1, '2000-01-01'),
    (2, NULL);

INSERT INTO l SELECT * FROM source;
INSERT INTO r SELECT vp_rowid FROM source;

-- 单表：实际返回 1.0
SELECT AVG(vp_rowid)
FROM source
WHERE c1timestamp IN (c1timestamp) OR ('a' LIKE 'b');

-- STRING_PACK 多表：实际返回 1.5
SELECT AVG(vp_rowid)
FROM (
    SELECT l.vp_rowid, l.c1timestamp
    FROM l
    JOIN (
        SELECT vp_rowid, CONCAT('vp:', vp_rowid) AS payload
        FROM r
    ) sp ON CONCAT('vp:', l.vp_rowid) = sp.payload
    JOIN r ON r.vp_rowid = sp.vp_rowid
) s
WHERE c1timestamp IN (c1timestamp) OR ('a' LIKE 'b');

单表： 1.0 
多表：1.5

单表：
EvalScalar: sum(vp_rowid) / if(count(vp_rowid) = 0, 1, count(vp_rowid))
└── AggregateFinal: sum(vp_rowid), count()
    └── AggregatePartial: sum(vp_rowid), count()
        └── TableScan: source
            └── push downs:
                is_true(source.c1timestamp = source.c1timestamp)
多表：
EvalScalar: sum(vp_rowid) / if(count(vp_rowid) = 0, 1, count(vp_rowid))
└── AggregateFinal: sum(vp_rowid), count()
    └── AggregatePartial: sum(vp_rowid), count()
        └── HashJoin: INNER
            ├── build key: r.vp_rowid
            ├── probe key: sp.vp_rowid
            ├── TableScan(Build): r
            └── HashJoin(Probe): INNER
                ├── build key: sp.payload
                ├── probe key: concat('vp:', CAST(l.vp_rowid AS String))
                ├── EvalScalar(Build): concat('vp:', CAST(r.vp_rowid AS String))
                │   └── TableScan: r
                └── TableScan(Probe): l
                    └── push downs: filters: []