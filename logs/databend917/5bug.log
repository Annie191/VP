CREATE TABLE source (
    id BIGINT NOT NULL,
    d DATE,
    a DECIMAL(43, 8),
    b DOUBLE
) ENGINE = MEMORY;

INSERT INTO source
SELECT ROW_NUMBER() OVER (ORDER BY c0date, c1decimal, c2float),
       c0date, c1decimal, c2float
FROM t0
LIMIT 37;

CREATE TABLE left_part (
    id BIGINT NOT NULL,
    a DECIMAL(43, 8),
    b DOUBLE
) ENGINE = FUSE;

CREATE TABLE right_part (
    id BIGINT NOT NULL,
    d DATE
) ENGINE = MEMORY;

INSERT INTO left_part SELECT id, a, b FROM source;
INSERT INTO right_part SELECT id, d FROM source;

CREATE TEMPORARY TABLE joined (
    id BIGINT NOT NULL,
    d DATE,
    a DECIMAL(43, 8),
    b DOUBLE
);

TRUNCATE TABLE joined;
INSERT INTO joined
SELECT l.id, r.d, l.a, l.b
FROM left_part l JOIN right_part r ON l.id = r.id;

TRUNCATE TABLE joined;
INSERT INTO joined
SELECT l.id, r.d, l.a, l.b
FROM left_part l JOIN right_part r ON l.id = r.id;

TRUNCATE TABLE joined;
INSERT INTO joined
SELECT l.id, r.d, l.a, l.b
FROM left_part l JOIN right_part r ON l.id = r.id;

TRUNCATE TABLE joined;
INSERT INTO joined
SELECT l.id, r.d, l.a, l.b
FROM left_part l JOIN right_part r ON l.id = r.id;

TRUNCATE TABLE joined;
INSERT INTO joined
SELECT l.id, r.d, l.a, l.b
FROM left_part l JOIN right_part r ON l.id = r.id;

-- 单表查询
SELECT d FROM source ORDER BY id LIMIT 8;

-- TEMP_TABLE 重构后的查询
SELECT d FROM joined ORDER BY id LIMIT 8;

source:
1969-12-15
1970-01-10
1970-01-10
1970-01-11
1970-01-13
1970-01-13
1970-01-17
2000-01-01

joined:
1969-12-15
1970-01-10
1970-01-10
1970-01-11
1970-01-13
1970-01-13
NULL
NULL

source:
Limit
└── Sort(Single), sort keys: [id ASC NULLS LAST]
    └── TableScan(source), output columns: [id, d]

joined:
RowFetch, columns to fetch: [d]
└── Limit
    └── Sort(Single), sort keys: [id ASC NULLS LAST]
        └── TableScan(joined), output columns: [id, _row_id]
            partitions total: 10
            partitions scanned: 5

临时表路径会在排序和 LIMIT 后通过 RowFetch 延迟读取日期列；单表路径则直接从 TableScan 读取日期。

joined 查询走了 延迟物化 + RowFetch：

先只扫描 id 和 _row_id，不读取 d；

对 id 排序；

取 LIMIT 8；

最后通过 _row_id 回表 RowFetch 读取 d 列。

问题就出在这个路径上：RowFetch 依赖 _row_id 能稳定、唯一地定位到原始行。但这里 joined 是临时表，又经过多次 TRUNCATE + INSERT，并且计划显示：

text
partitions total: 10
partitions scanned: 5
只扫描了 5/10 个分区。排序和 LIMIT 之后，再通过 _row_id 回表取 d，很可能出现了 _row_id 与分区/版本不匹配，导致部分行回表读到 NULL 或错误行。