CREATE TABLE l (
    vp_rowid BIGINT NOT NULL,
    c2decimal DECIMAL(35,2) NULL,
    c0geometry GEOMETRY NULL
) ENGINE=FUSE;

CREATE TABLE r (
    vp_rowid BIGINT NOT NULL,
    c1geometry GEOMETRY NULL
) ENGINE=FUSE;

ALTER TABLE source CLUSTER BY (vp_rowid);
ALTER TABLE l CLUSTER BY (c2decimal);
ALTER TABLE r CLUSTER BY (vp_rowid);

-- Initial materialization, then rebuild the split layout.  The truncate is
-- significant: it leaves the same kind of FUSE history as the VP setup.
INSERT INTO l SELECT vp_rowid, c2decimal, c0geometry FROM source ORDER BY vp_rowid DESC;
INSERT INTO r SELECT vp_rowid, c1geometry FROM source ORDER BY vp_rowid;
TRUNCATE TABLE l;
TRUNCATE TABLE r;

-- Preserve the physical history that is required by the 950 nightly failure:
-- eight reverse-ordered left batches and two right batches, followed by left compaction.
INSERT INTO l SELECT vp_rowid, c2decimal, c0geometry FROM source WHERE vp_rowid > 54 AND vp_rowid <= 62 ORDER BY vp_rowid DESC;
INSERT INTO l SELECT vp_rowid, c2decimal, c0geometry FROM source WHERE vp_rowid > 46 AND vp_rowid <= 54 ORDER BY vp_rowid DESC;
INSERT INTO l SELECT vp_rowid, c2decimal, c0geometry FROM source WHERE vp_rowid > 38 AND vp_rowid <= 46 ORDER BY vp_rowid DESC;
INSERT INTO l SELECT vp_rowid, c2decimal, c0geometry FROM source WHERE vp_rowid > 30 AND vp_rowid <= 38 ORDER BY vp_rowid DESC;
INSERT INTO l SELECT vp_rowid, c2decimal, c0geometry FROM source WHERE vp_rowid > 22 AND vp_rowid <= 30 ORDER BY vp_rowid DESC;
INSERT INTO l SELECT vp_rowid, c2decimal, c0geometry FROM source WHERE vp_rowid > 14 AND vp_rowid <= 22 ORDER BY vp_rowid DESC;
INSERT INTO l SELECT vp_rowid, c2decimal, c0geometry FROM source WHERE vp_rowid > 6 AND vp_rowid <= 14 ORDER BY vp_rowid DESC;
INSERT INTO l SELECT vp_rowid, c2decimal, c0geometry FROM source WHERE vp_rowid > 4 AND vp_rowid <= 6 ORDER BY vp_rowid DESC;
INSERT INTO r SELECT vp_rowid, c1geometry FROM source WHERE MOD(vp_rowid, 2) = 0 ORDER BY vp_rowid;
INSERT INTO r SELECT vp_rowid, c1geometry FROM source WHERE MOD(vp_rowid, 2) = 1 ORDER BY vp_rowid;
OPTIMIZE TABLE l COMPACT;

SELECT s.c1geometry,
       (SELECT MIN(s2.vp_rowid)
        FROM (SELECT s0.vp_rowid, s0.c0geometry, s0.c1geometry, s0.c2decimal
              FROM source s0) s2
        WHERE s2.vp_rowid <= s.vp_rowid)
FROM source s;

SELECT s.c1geometry,
       (SELECT MIN(s2.vp_rowid)
        FROM (SELECT l.vp_rowid, l.c0geometry,
                     (SELECT r.c1geometry FROM r r WHERE r.vp_rowid = l.vp_rowid) AS c1geometry,
                     l.c2decimal
              FROM l l
              WHERE EXISTS (SELECT 1 FROM r r WHERE r.vp_rowid = l.vp_rowid)) s2
        WHERE s2.vp_rowid <= s.vp_rowid)
FROM (SELECT l.vp_rowid, l.c0geometry,
             (SELECT r.c1geometry FROM r r WHERE r.vp_rowid = l.vp_rowid) AS c1geometry,
             l.c2decimal
      FROM l l
      WHERE EXISTS (SELECT 1 FROM r r WHERE r.vp_rowid = l.vp_rowid)) s;

