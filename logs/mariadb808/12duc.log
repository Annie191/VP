https://jira.mariadb.org/browse/MDEV-41081   similar of MDEV-29259

DROP DATABASE IF EXISTS repro_mariadb808_db12_min;
CREATE DATABASE repro_mariadb808_db12_min;
USE repro_mariadb808_db12_min;

CREATE TABLE source_rows (
    vp_rowid BIGINT NOT NULL PRIMARY KEY,
    c0 TINYINT(1),
    c1 CHAR(1) NOT NULL,
    KEY idx_source (vp_rowid, c0)
);

CREATE TABLE left_rows (
    vp_rowid BIGINT NOT NULL PRIMARY KEY,
    c0 TINYINT(1),
    KEY idx_left (c0, vp_rowid)
);

CREATE TABLE right_rows (
    vp_rowid BIGINT NOT NULL PRIMARY KEY,
    c1 CHAR(1) NOT NULL
);

INSERT INTO source_rows VALUES
    (1, 0, 'a'),
    (2, 0, 'b'),
    (3, 1, 'c');

INSERT INTO left_rows
SELECT vp_rowid, c0 FROM source_rows;

INSERT INTO right_rows
SELECT vp_rowid, c1 FROM source_rows;

-- 原始单表查询：实际返回 0 行
SELECT vp_rowid, c0
FROM source_rows
WHERE '0.45' IN (c0);

-- VP 多表重构查询：错误返回 c0=0 的两行
SELECT vp_rowid, c0
FROM (
    SELECT l.vp_rowid, l.c0, r.c1
    FROM left_rows AS l
    LEFT JOIN right_rows AS r
        ON r.vp_rowid = l.vp_rowid
) AS reconstructed
WHERE '0.45' IN (c0);

single-table:
Empty set

left-join-derived:
+----------+------+
| vp_rowid | c0   |
+----------+------+
|        1 |    0 |
|        2 |    0 |
+----------+------+


单表执行计划：
table        type   key         key_len  rows  Extra
source_rows  index  idx_source  10       3     Using where; Using index; Using temporary
VP 多表执行计划：
table  type  key       key_len  ref    rows  Extra
l      ref   idx_left  2        const  2     Using index; Using temporary
right_rows 没出现在最终计划中，是因为查询不使用 c1，优化器合法消除了 LEFT JOIN；但保留了原日志中的多表派生查询结构。

进一步关闭问题索引：
SELECT vp_rowid, c0
FROM left_rows IGNORE INDEX (idx_left)
WHERE '0.45' IN (c0);
实际恢复为 0 行，执行计划变为：
table      type  key   rows  Extra
left_rows  ALL   NULL  3     Using where; Using temporary
因此问题非常明确：使用 (c0, vp_rowid) 索引的 ref 访问时，MariaDB 错误地把字符串数值 '0.45' 转成整数索引键 0，从而命中 c0=0；全表扫描则按照正确的数值比较语义返回 0 行。