SET disable_join_reorder = 0;
SET enable_bloom_runtime_filter = 1;
SET enable_cbo = 1;
SET enable_join_runtime_filter = 1;
SET enable_query_result_cache = 0;
SET max_threads = 40;
SET numeric_cast_option = 'rounding';
SET sql_dialect = 'PostgreSQL';
SET timezone = 'UTC';

CREATE TABLE source7 (
  vp_rowid BIGINT NOT NULL,
  c0timestamp TIMESTAMP NULL,
  c1array ARRAY(BIGINT NULL) NULL,
  c2tuple TUPLE(BIGINT NULL, VARCHAR NULL) NOT NULL,
  c3array ARRAY(BIGINT NULL) NULL DEFAULT [1, 2, 3],
  c4float DOUBLE NULL DEFAULT 0.9876939654,
  c5geometry GEOMETRY NOT NULL,
  c6tuple TUPLE(BIGINT NULL, VARCHAR NULL) NULL,
  c7date DATE NULL DEFAULT '1970-01-25'
) ENGINE = MEMORY;

