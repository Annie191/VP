CREATE TABLE left7 (
  vp_rowid BIGINT NOT NULL,
  c4float DOUBLE NULL,
  c5geometry GEOMETRY NULL,
  c3array ARRAY(BIGINT NULL) NULL,
  c6tuple TUPLE(BIGINT NULL, VARCHAR NULL) NULL,
  c2tuple TUPLE(BIGINT NULL, VARCHAR NULL) NULL
) ENGINE = MEMORY;

CREATE TABLE right7 (
  vp_rowid BIGINT NOT NULL,
  c0timestamp TIMESTAMP NULL,
  c2tuple TUPLE(BIGINT NULL, VARCHAR NULL) NULL,
  c1array ARRAY(BIGINT NULL) NULL,
  c7date DATE NULL
) ENGINE = FUSE;

INSERT INTO left7
SELECT vp_rowid, c4float, c5geometry, c3array, c6tuple, c2tuple
FROM source7;

INSERT INTO right7
SELECT vp_rowid, c0timestamp, c2tuple, c1array, c7date
FROM source7;

SELECT c7date
FROM source7
WHERE c0timestamp IN (c0timestamp, c0timestamp, c0timestamp)
ORDER BY c0timestamp, vp_rowid, c7date, c4float;

SELECT x.c7date
FROM (
  SELECT l.vp_rowid, r.c0timestamp, l.c4float, r.c7date
  FROM left7 l
  LEFT JOIN right7 r
    ON l.vp_rowid = r.vp_rowid

  UNION ALL

  SELECT r.vp_rowid, r.c0timestamp, l.c4float, r.c7date
  FROM left7 l
  RIGHT JOIN right7 r
    ON l.vp_rowid = r.vp_rowid
  WHERE l.vp_rowid IS NULL
) x
WHERE x.c0timestamp IN (x.c0timestamp, x.c0timestamp, x.c0timestamp)
ORDER BY x.c0timestamp, x.vp_rowid, x.c7date, x.c4float;

