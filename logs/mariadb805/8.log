DROP DATABASE IF EXISTS repro_mariadb805_db8_min;
CREATE DATABASE repro_mariadb805_db8_min;
USE repro_mariadb805_db8_min;

CREATE TABLE source_base (
    c0 REAL ZEROFILL UNIQUE
) ENGINE=InnoDB;

INSERT INTO source_base VALUES (364518939);

CREATE TABLE vp_source LIKE source_base;
ALTER TABLE vp_source ADD COLUMN vp_rowid BIGINT NOT NULL FIRST;

INSERT INTO vp_source (vp_rowid, c0)
SELECT ROW_NUMBER() OVER (ORDER BY c0), c0
FROM source_base;

CREATE TABLE vp_left (
    vp_rowid BIGINT NOT NULL,
    c0 REAL ZEROFILL
) ENGINE=InnoDB;

CREATE TABLE vp_right (
    vp_rowid BIGINT NOT NULL,
    c0 REAL ZEROFILL
) ENGINE=InnoDB;

INSERT INTO vp_left
SELECT vp_rowid, c0 FROM vp_source;

INSERT INTO vp_right
SELECT vp_rowid, c0 FROM vp_source;

SELECT 'DIRECT' AS variant, c0
FROM vp_source
WHERE c0 REGEXP (1890746649 XOR (-TRUE));

SELECT 'RECONSTRUCTED' AS variant, c0
FROM (
    SELECT l.vp_rowid, r.c0
    FROM vp_left l
    LEFT JOIN vp_right r
        ON l.vp_rowid = r.vp_rowid

    UNION ALL

    SELECT r.vp_rowid, r.c0
    FROM vp_left l
    RIGHT JOIN vp_right r
        ON l.vp_rowid = r.vp_rowid
    WHERE l.vp_rowid IS NULL
) AS reconstructed
WHERE c0 REGEXP (1890746649 XOR (-TRUE));

直接单表查询：
variant | c0
-------- | ------------------------
DIRECT  | 0000000000000364518939

保留原始结构的多表 FULL OUTER JOIN；
Empty set

执行计划：
直接查询：
id  select_type  table      type   key  rows  Extra
1   SIMPLE       vp_source  index  c0   1     Using where; Using index; Using temporary
重构查询：
id  select_type  table       type  rows  Extra
1   PRIMARY      <derived2>  ALL   2     Using where; Using temporary
2   DERIVED      l           ALL   1
2   DERIVED      r           ALL   1     Using where
3   UNION        r           ALL   1
3   UNION        l           ALL   1     Using where; Not exists

REAL ZEROFILL 的显示和字符串转换语义发生了变化：
- 直接访问 vp_source.c0 时得到带前导零的字符串：
  0000000000000364518939
- 通过 JOIN/UNION 派生表输出时得到普通字符串：
  364518939