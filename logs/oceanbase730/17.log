DROP DATABASE IF EXISTS repro_ob730_db17_min;
CREATE DATABASE repro_ob730_db17_min;
USE repro_ob730_db17_min;

SET SESSION sql_mode = 'STRICT_ALL_TABLES,NO_ZERO_IN_DATE,NO_AUTO_CREATE_USER';
SET NAMES utf8mb4 COLLATE utf8mb4_general_ci;
SET SESSION ob_enable_aggregation_pushdown = 0;

CREATE TABLE src (
  vp_rowid BIGINT NOT NULL PRIMARY KEY,
  c0 VARCHAR(500) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin,
  c1 VARCHAR(500)
) ENGINE=InnoDB PARTITION BY HASH(vp_rowid) PARTITIONS 8;

INSERT INTO src VALUES
  (1, '2024-02-29', NULL),
  (2, '2024-02-29', '0000-00-00');

CREATE TABLE l LIKE src;
CREATE TABLE r (
  vp_rowid BIGINT NOT NULL PRIMARY KEY,
  c0 VARCHAR(500) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin
) ENGINE=InnoDB PARTITION BY HASH(vp_rowid) PARTITIONS 8;

INSERT INTO l SELECT * FROM src;
INSERT INTO r SELECT vp_rowid, c0 FROM src;

CREATE TEMPORARY TABLE jt (
  vp_rowid BIGINT NOT NULL PRIMARY KEY,
  c0 VARCHAR(500) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin,
  c1 VARCHAR(500)
);
INSERT INTO jt
SELECT l.vp_rowid, r.c0, l.c1
FROM l JOIN r ON l.vp_rowid = r.vp_rowid;

SELECT /*+ PARALLEL(4) */ DISTINCT
  BIT_OR(vp_rowid) AS b,
  ((0.67 || c0) <= vp_rowid) AS g1,
  (((vp_rowid != c1) > -1) >= CAST(c0 IS FALSE AS SIGNED)) AS g2
FROM src
GROUP BY
  ((0.67 || c0) <= vp_rowid),
  (((vp_rowid != c1) > -1) >= CAST(c0 IS FALSE AS SIGNED))
WITH ROLLUP
ORDER BY g1, g2;

SELECT /*+ PARALLEL(4) */ DISTINCT
  BIT_OR(vp_rowid) AS b,
  ((0.67 || c0) <= vp_rowid) AS g1,
  (((vp_rowid != c1) > -1) >= CAST(c0 IS FALSE AS SIGNED)) AS g2
FROM jt
GROUP BY
  ((0.67 || c0) <= vp_rowid),
  (((vp_rowid != c1) > -1) >= CAST(c0 IS FALSE AS SIGNED))
WITH ROLLUP
ORDER BY g1, g2;

连续 12 次中有 7 次两侧不一致。典型差异：
单表: 1/1/NULL, 2/1/1, 3/NULL/1, 3/1/1
多表: 1/1/NULL, 2/1/1, 3/NULL/NULL, 3/1/NULL

在 GROUP BY ... WITH ROLLUP 查询中，汇总行（super‑aggregate row）上的 g2 本应为 NULL，但 OceanBase 在某些执行路径下错误地重新计算了该表达式，而非直接用 NULL 填充，导致 g2 出现非预期的值。

单表查询时，汇总行恰好用到了 c1='0000-00-00' 那一行的数据重新求值，得出 g2=1；多表查询时（临时表 jt 由 JOIN 生成），并行执行内部取到的却是 c1=NULL 的行，重新求值得出 g2=NULL。两者因取到的具体行不同而结果不一致。

根因：OceanBase 在启用并行（PARALLEL(4)）且禁用聚合下推（ob_enable_aggregation_pushdown=0）时，对 WITH ROLLUP 的分组表达式错误地进行了重计算，违反了“汇总行分组列必须为 NULL”的标准行为。

